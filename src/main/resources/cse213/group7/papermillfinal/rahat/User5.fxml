<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="cse213.group7.papermillfinal.DashboardController">

    <!-- Title -->
    <Label layoutX="30" layoutY="30" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Finance  Cost Analyst Panel" />

    <!-- Buttons -->
    <Button layoutX="30" layoutY="90" onAction="#runCostAnalysisOA" text="Run Cost Analysis" />

    <Button layoutX="30" layoutY="140" onAction="#openProfitDashboardOA" text="Profit Dashboard" />

    <Button layoutX="30" layoutY="190" onAction="#runBudgetPlanningOA" text="Budget Planning" />

    <Button layoutX="30" layoutY="240" onAction="#generateFinancialReportOA" text="Generate Financial Report" />

    <Button layoutX="30" layoutY="290" onAction="#optimizeProcurementOA" text="Optimize Procurement Costs" />

    <Button layoutX="30" layoutY="340" onAction="#runTaxSimulationOA" text="Run Tax Simulation" />

</AnchorPane>
