<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.group7.papermillfinal.rahat.financeController">

    <Label layoutX="20" layoutY="20" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Financial Cost Analysis (User 5 - Goal 1)" />

    <!-- Steps / Description -->
    <Label layoutX="20" layoutY="60" prefWidth="560" text="Description: Simulate financial cost analysis for paper production." wrapText="true" />

    <!-- Process Table -->
    <TableView fx:id="eventTable" layoutX="20" layoutY="100" prefHeight="160" prefWidth="560">

        <columns>
            <TableColumn fx:id="colDescription" prefWidth="380" text="Description" />
            <TableColumn fx:id="colType" prefWidth="160" text="Type" />
        </columns>

    </TableView>

    <!-- Run Button -->
    <Button layoutX="20" layoutY="280" onAction="#runCostAnalysisOA" prefWidth="200" text="Run Cost Analysis" />


</AnchorPane>
