<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.group7.papermillfinal.meher.User4Goal4Controller">

    <children>

        <!-- Title -->
        <Label layoutX="180.0" layoutY="20.0" text="Quality Assurance Report Generator">
            <font>
                <Font name="Arial Black" size="16.0" />
            </font>
        </Label>

        <!-- Batch ID Input -->
        <Label layoutX="30.0" layoutY="90.0" text="Batch ID" />
        <TextField fx:id="batchIDTextField" layoutX="110.0" layoutY="85.0" prefWidth="180.0" />

        <!-- OR Date Range -->
        <Label layoutX="30.0" layoutY="135.0" text="OR Select Date Range:" />

        <Label layoutX="30.0" layoutY="165.0" text="Start Date" />
        <DatePicker fx:id="startDatePicker" layoutX="110.0" layoutY="160.0" prefWidth="160.0" />

        <Label layoutX="300.0" layoutY="165.0" text="End Date" />
        <DatePicker fx:id="endDatePicker" layoutX="360.0" layoutY="160.0" prefWidth="160.0" />

        <!-- Generate Report Button -->
        <Button layoutX="540.0" layoutY="115.0" onAction="#generateQAReport" prefHeight="40.0" prefWidth="130.0" text="Generate Report" />

        <!-- Test Data Table -->
        <Label layoutX="30.0" layoutY="220.0" text="Quality Test Data:" />
        <TableView fx:id="testDataTable" layoutX="30.0" layoutY="245.0" prefHeight="150.0" prefWidth="640.0">

            <columns>
                <TableColumn fx:id="batchIDCol" prefWidth="120" text="Batch ID" />
                <TableColumn fx:id="testPropertyCol" prefWidth="180" text="Test Property" />
                <TableColumn fx:id="valueCol" prefWidth="160" text="Value" />
                <TableColumn fx:id="statusCol" prefWidth="176.6666259765625" text="Status" />
            </columns>
        </TableView>

        <!-- QA Report -->
        <Label layoutX="30.0" layoutY="410.0" text="QA Report Summary:" />
        <TextArea fx:id="reportTextArea" layoutX="150.0" layoutY="405.0" prefHeight="80.0" prefWidth="400.0" />

        <!-- Back Button -->
        <Button layoutX="570.0" layoutY="435.0" onAction="#handleBackButton" prefHeight="30.0" prefWidth="100.0" text="Back" />

    </children>

</AnchorPane>
