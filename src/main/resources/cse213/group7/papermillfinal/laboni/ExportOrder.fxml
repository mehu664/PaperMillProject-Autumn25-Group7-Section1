<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="346.0" prefWidth="650.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="cse213.group7.papermillfinal.laboni.ExportOrderController">

    <Label layoutX="200" layoutY="10" prefHeight="38.0" prefWidth="251.0" style="-fx-font-size: 20px;" text="Export Customer Order Data" />

    <Label layoutX="64.0" layoutY="72.0" text="Start Date:" />
    <DatePicker fx:id="startDatePicker" layoutX="150.0" layoutY="65.0" prefHeight="30.0" prefWidth="200.0" />

    <Label layoutX="367.0" layoutY="72.0" text="End Date:" />
    <DatePicker fx:id="endDatePicker" layoutX="436.0" layoutY="65.0" prefHeight="30.0" prefWidth="200.0" />

    <Label layoutX="60.0" layoutY="124.0" text="Order Type:" />
    <ComboBox fx:id="typeComboBox" layoutX="150.0" layoutY="117.0" prefHeight="30.0" prefWidth="200" />

    <Button layoutX="223.0" layoutY="173.0" onAction="#exportOrders" text="Export Order Data" />

    <Label layoutX="60.0" layoutY="223.0" text="Status:" />
    <TextArea fx:id="statusArea" layoutX="124.0" layoutY="217.0" prefHeight="94.0" prefWidth="442.0" promptText="Status messages" />
   <Button layoutX="26.0" layoutY="25.0" mnemonicParsing="false" onAction="#backOA" prefHeight="32.0" prefWidth="51.0" text="&lt;">
      <font>
         <Font name="Arial Black" size="14.0" />
      </font>
   </Button>

</AnchorPane>
