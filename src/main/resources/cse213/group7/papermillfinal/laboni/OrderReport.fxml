<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="536.0" prefWidth="800.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="cse213.group7.papermillfinal.laboni.OrderReportController">

    <!-- Title -->
    <Label layoutX="289.0" layoutY="7.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Customer Order Report" />

    <!-- Date Range Input -->
    <Label layoutX="63.0" layoutY="92.0" text="Start Date:" />
    <DatePicker fx:id="startDatePicker" layoutX="163.0" layoutY="84.0" prefHeight="32.0" prefWidth="200.0" />

    <Label layoutX="430.0" layoutY="92.0" text="End Date:" />
    <DatePicker fx:id="endDatePicker" layoutX="521.0" layoutY="88.0" prefHeight="32.0" prefWidth="200.0" />

    <!-- Customer UID Input -->
    <Label layoutX="52.0" layoutY="156.0" text="Customer UID:" />
    <TextField fx:id="customerUidField" layoutX="163.0" layoutY="148.0" prefHeight="32.0" prefWidth="200" />

    <!-- Action Buttons -->
    <Button layoutX="529.0" layoutY="152.0" onAction="#generateReport" prefHeight="32.0" prefWidth="200" text="Generate Report" />

    <Button layoutX="18.0" layoutY="14.0" onAction="#goBack" prefHeight="32.0" prefWidth="67.0" text="&lt;">
      <font>
         <Font name="Arial Black" size="14.0" />
      </font></Button>

    <!-- Table to Display Report Data -->
    <TableView fx:id="reportTable" layoutX="65.0" layoutY="208.0" prefHeight="200" prefWidth="671.0">
        <columns>
            <TableColumn fx:id="orderIdCol" prefWidth="100" text="Order ID" />
            <TableColumn fx:id="customerCol" prefWidth="150" text="Customer" />
            <TableColumn fx:id="dateCol" prefWidth="150" text="Date" />
            <TableColumn fx:id="qtyCol" prefWidth="120" text="Quantity" />
            <TableColumn fx:id="statusCol" prefWidth="150" text="Status" />
        </columns>
    </TableView>

    <!-- Status Message Box -->
    <Label layoutX="30.0" layoutY="465.0" text="Status:" />
    <TextArea fx:id="statusArea" layoutX="90" layoutY="440.0" prefHeight="75.0" prefWidth="653.0" />
   <Button layoutX="677.0" layoutY="18.0" mnemonicParsing="false" onAction="#ResetOA" prefHeight="35.0" prefWidth="77.0" text="Reset" />
</AnchorPane>
