<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="561.0" prefWidth="700" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="cse213.group7.papermillfinal.laboni.SurveyController">

    <Label layoutX="250" layoutY="10" style="-fx-font-size: 20px;" text="Customer Satisfaction Survey" />

    <Label layoutX="50" layoutY="60" text="Order ID:" />
    <ComboBox fx:id="orderComboBox" layoutX="150" layoutY="55" prefHeight="30.0" prefWidth="200" />

    <Label layoutX="50" layoutY="100" text="Customer:" />
    <TextField fx:id="customerField" layoutX="150" layoutY="95" prefHeight="30.0" prefWidth="200" />

    <Label layoutX="50" layoutY="140" text="Rating:" />
    <ComboBox fx:id="ratingComboBox" layoutX="150" layoutY="135" prefHeight="30.0" prefWidth="200.0" />

    <Label layoutX="51.0" layoutY="186.0" text="Feedback:" />
    <TextArea fx:id="feedbackArea" layoutX="150.0" layoutY="180.0" prefHeight="60" prefWidth="400" />

    <Button layoutX="296.0" layoutY="257.0" onAction="#submitSurvey" prefHeight="32.0" prefWidth="92.0" text="Submit Survey" />

    <Label layoutX="57.0" layoutY="312.0" text="Status:" />
    <TextArea fx:id="statusArea" layoutX="120.0" layoutY="299.0" prefHeight="60" prefWidth="500" promptText="Status messages" />

    <TableView fx:id="surveyTable" layoutX="59.0" layoutY="376.0" prefHeight="165.0" prefWidth="600">
        <columns>
            <TableColumn fx:id="orderIdCol" prefWidth="100" text="Order ID" />
            <TableColumn fx:id="customerCol" prefWidth="150" text="Customer" />
            <TableColumn fx:id="ratingCol" prefWidth="100" text="Rating" />
            <TableColumn fx:id="feedbackCol" prefWidth="250" text="Feedback" />
        </columns>
    </TableView>
   <Button layoutX="24.0" layoutY="13.0" mnemonicParsing="false" onAction="#BackOA" prefHeight="32.0" prefWidth="43.0" text="&lt;">
      <font>
         <Font name="Arial Black" size="14.0" />
      </font>
   </Button>

</AnchorPane>
