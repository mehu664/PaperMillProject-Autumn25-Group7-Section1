<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="461.0" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="cse213.group7.papermillfinal.laboni.CustomerUpdateController">

    <Label layoutX="160.0" layoutY="10" prefHeight="32.0" prefWidth="305.0" style="-fx-font-size: 20px;" text="Update Customer Information">
      <font>
         <Font name="System Bold Italic" size="12.0" />
      </font></Label>

    <Label layoutX="54.0" layoutY="62.0" prefHeight="25.0" prefWidth="77.0" text="Customer UID:" />
    <TextField fx:id="uidField" layoutX="170" layoutY="55" prefHeight="32.0" prefWidth="200" />
    <Button layoutX="400" layoutY="55" onAction="#fetchCustomer" prefHeight="32.0" prefWidth="100.0" text="Fetch Customer" />

    <Label layoutX="69.0" layoutY="105.0" prefHeight="25.0" prefWidth="35.0" text="Name:" />
    <TextField fx:id="nameField" layoutX="170.0" layoutY="101.0" prefHeight="32.0" prefWidth="200" />

    <Label layoutX="73.0" layoutY="157.0" prefHeight="25.0" prefWidth="35.0" text="Email:" />
    <TextField fx:id="emailField" layoutX="170.0" layoutY="149.0" prefHeight="32.0" prefWidth="200" />

    <Label layoutX="67.0" layoutY="205.0" prefHeight="25.0" prefWidth="51.0" text="Phone:" />
    <TextField fx:id="phoneField" layoutX="173.0" layoutY="197.0" prefHeight="32.0" prefWidth="200" />

    <Button fx:id="updateBtn" layoutX="173.0" layoutY="250.0" onAction="#updateCustomer" prefHeight="32.0" prefWidth="100.0" text="Update" />
    <Button layoutX="333.0" layoutY="250.0" onAction="#resetFields" prefHeight="32.0" prefWidth="100.0" text="Reset" />

    <TextArea fx:id="statusArea" layoutX="50.0" layoutY="305.0" prefHeight="117.0" prefWidth="500" promptText="Status messages" />
   <Button layoutX="24.0" layoutY="13.0" mnemonicParsing="false" onAction="#backOA" prefHeight="32.0" prefWidth="62.0" text="&lt;">
      <font>
         <Font name="Arial Black" size="14.0" />
      </font>
   </Button>
</AnchorPane>
