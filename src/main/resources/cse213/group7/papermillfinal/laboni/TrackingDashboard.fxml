<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="560.0" prefWidth="751.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.group7.papermillfinal.laboni.TrackingDashboardController">

    <children>

        <!-- Header -->
        <Label layoutX="213.0" layoutY="30.0" text="Order Tracking Dashboard">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <!-- Refresh Button -->
        <Button layoutX="637.0" layoutY="33.0" onAction="#refreshOA" prefHeight="32.0" prefWidth="72.0" text="Refresh" />

        <!-- Table: Order Status -->
        <TableView fx:id="orderTable" layoutX="38.0" layoutY="127.0" prefHeight="229.0" prefWidth="653.0">

            <columns>
                <TableColumn fx:id="orderIdCol" prefWidth="112.0" text="Order ID" />
                <TableColumn fx:id="customerCol" prefWidth="117.0" text="Customer" />
                <TableColumn fx:id="typeCol" prefWidth="131.0" text="Product Type" />
                <TableColumn fx:id="qtyCol" prefWidth="88.0" text="Qty (kg)" />
                <TableColumn fx:id="statusCol" minWidth="0.0" prefWidth="91.0" text="Status" />
                <TableColumn fx:id="etaCol" prefWidth="114.0" text="Estimated Delivery" />
            </columns>
        </TableView>

        <!-- Fulfillment Progress -->
        <Label layoutX="30.0" layoutY="400.0" text="Overall Fulfillment Progress:" />
        <ProgressBar fx:id="progressBar" layoutX="250.0" layoutY="395.0" prefHeight="32.0" prefWidth="393.0" progress="0.0" />
        <TextArea fx:id="alertArea" layoutX="38.0" layoutY="459.0" prefHeight="60.0" prefWidth="653.0" promptText="Delay alerts will appear here…" />
      <Button layoutX="27.0" layoutY="33.0" mnemonicParsing="false" onAction="#BackOA" prefHeight="25.0" prefWidth="72.0" text="&lt;">
         <font>
            <Font name="Arial Black" size="14.0" />
         </font>
      </Button>

    </children>

</AnchorPane>
