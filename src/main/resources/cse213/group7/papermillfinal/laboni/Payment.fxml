<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500" prefWidth="700" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.group7.papermillfinal.laboni.PaymentController">

    <Label layoutX="280" layoutY="10" style="-fx-font-size: 20px;" text="Customer Payment Processing">
      <font>
         <Font name="System Bold Italic" size="12.0" />
      </font></Label>

    <Label layoutX="50" layoutY="60" text="Order ID:" />
    <TextField fx:id="orderIdField" layoutX="150" layoutY="55" prefWidth="200" />

    <Label layoutX="50" layoutY="100" text="Customer:" />
    <TextField fx:id="customerField" layoutX="150" layoutY="95" prefWidth="200" />

    <Label layoutX="50" layoutY="140" text="Amount:" />
    <TextField fx:id="amountField" layoutX="150" layoutY="135" prefWidth="200" />

    <Button fx:id="processBtn" layoutX="400" layoutY="90" onAction="#processPayment" prefHeight="25.0" prefWidth="154.0" text="Process Payment" />

    <Button layoutX="400" layoutY="135" onAction="#resetFields" prefHeight="25.0" prefWidth="154.0" text="Reset" />

    <TextArea fx:id="statusArea" layoutX="50" layoutY="180" prefHeight="100" prefWidth="600" promptText="Status messages" />

    <TableView fx:id="paymentTable" layoutX="73.0" layoutY="304.0" prefHeight="150" prefWidth="554.0">
        <columns>
            <TableColumn fx:id="orderIdCol" prefWidth="100" text="Order ID" />
            <TableColumn fx:id="customerCol" prefWidth="150" text="Customer" />
            <TableColumn fx:id="amountCol" prefWidth="150" text="Amount" />
            <TableColumn fx:id="statusCol" prefWidth="150" text="Status" />
        </columns>
    </TableView>
   <Button layoutX="32.0" layoutY="13.0" mnemonicParsing="false" onAction="#backOA" prefHeight="25.0" prefWidth="61.0" text="&lt;">
      <font>
         <Font name="Arial Black" size="14.0" />
      </font>
   </Button>

</AnchorPane>
