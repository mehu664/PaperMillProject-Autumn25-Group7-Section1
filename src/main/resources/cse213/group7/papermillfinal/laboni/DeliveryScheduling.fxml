<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="585.0" prefWidth="756.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.group7.papermillfinal.laboni.DeliveryScheduleController">

    <children>

        <!-- Title -->
        <Label layoutX="270.0" layoutY="20.0" text="Delivery Scheduling Dashboard">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <!-- Buttons -->
        <Button layoutX="50.0" layoutY="70.0" onAction="#fetchOrders" prefHeight="32.0" prefWidth="140.0" text="Fetch Orders" />

        <Button layoutX="220.0" layoutY="70.0" onAction="#calculateSchedule" prefHeight="32.0" prefWidth="170.0" text="Calculate Schedule" />

        <Button layoutX="50.0" layoutY="20.0" onAction="#goBack" prefHeight="28.0" prefWidth="60.0" text="&lt;">
            <font>
                <Font name="Arial Black" size="14.0" />
            </font>
        </Button>


        <!-- Orders Table (Fetched Data) -->
        <Label layoutX="50.0" layoutY="120.0" text="Orders:" />
        <TableView fx:id="orderTable" layoutX="50.0" layoutY="150.0" prefHeight="150.0" prefWidth="642.0">

            <columns>
                <TableColumn fx:id="orderIdCol" prefWidth="120.0" text="Order ID" />
                <TableColumn fx:id="customerCol" prefWidth="150.0" text="Customer" />
                <TableColumn fx:id="qtyCol" prefWidth="100.0" text="Qty (kg)" />
                <TableColumn fx:id="distanceCol" prefWidth="150.0" text="Distance (km)" />
                <TableColumn fx:id="priorityCol" prefWidth="120.0" text="Priority" />
            </columns>
        </TableView>


        <!-- Delivery Schedule Table -->
        <Label layoutX="50.0" layoutY="320.0" text="Generated Delivery Plan:" />
        <TableView fx:id="scheduleTable" layoutX="50.0" layoutY="350.0" prefHeight="150.0" prefWidth="573.0">

            <columns>
                <TableColumn fx:id="planOrderIdCol" prefWidth="120.0" text="Order ID" />
                <TableColumn fx:id="vehicleCol" prefWidth="150.0" text="Vehicle Assigned" />
                <TableColumn fx:id="etaCol" prefWidth="150.0" text="Estimated Delivery Time" />
                <TableColumn fx:id="statusCol" prefWidth="150.0" text="Feasibility" />
            </columns>
        </TableView>

        <!-- Alerts / Feasibility Result -->
        <Label layoutX="50.0" layoutY="520.0" text="Status:" />
        <TextArea fx:id="statusArea" layoutX="110.0" layoutY="514.0" prefHeight="46.0" prefWidth="532.0" promptText="Feasibility checks and schedule details will appear here…" />

    </children>
</AnchorPane>
